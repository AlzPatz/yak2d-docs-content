{
  "build": {
    "content": [
      {
        "files": [
          "api/*.yml",
          "api/**/*.yml",
          "api/index.md",
          "api/toc.yml",
          "api/**/toc.yml"
        ]
      },
      {
        "files": [
          "articles/**.md",
          "articles/**/toc.yml",
          "tutorials/**.md",
          "tutorials/**/toc.yml",
          "toc.yml",
          "*.md"
        ],
        "exclude": [
          "README.md"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**",
          "favicon.ico"
        ]
      }
    ],
    "dest": "_site",
    "globalMetadata": {
      "_appName": "yak2D",
      "_appTitle": "yak2D",
      "_appFooter": "yak2D - Alex Paterson - MIT licence",
      "_appLogoPath": "images/logo.png",
      "_appFaviconPath": "favicon.ico",
      "_enableSearch": true,
      "_disableContribution": true,
      "_gitContribute": {
        "repo": "https://github.com/AlzPatz/yak2d-docs-content",
        "branch": "master"
      }
    },
    "fileMetadataFiles": [],
    "template": [
      "default",
      "modern"
    ],
    "postProcessors": [],
    "markdownEngineName": "markdig",
    "noLangKeyword": false,
    "keepFileLink": false,
    "cleanupCacheHistory": false,
    "disableGitFeatures": false
  }
}
